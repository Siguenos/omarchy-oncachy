#!/usr/bin/env bash
# agents — gère les agents Claude lancés dans des sessions screen sur la VM pivot.
#
#   agents                    liste les agents (alias : agents ls)
#   agents new [-d dossier] [--shell] <nom> [titre]
#                             crée l'agent <nom> et y lance `claude --remote-control "<titre>"` (Remote Control actif,
#                             nommé d'après le titre, sinon le nom) ; s'il existe déjà, s'y reconnecte.
#                             Dossier de travail sur la VM : -d <dossier> si donné ; sinon le dossier courant s'il est dans la racine
#                             synchronisée (~/.config/agents/sync, même chemin des deux côtés) ; sinon ~/.config/agents/dir, sinon ~.
#                             --shell : shell seul, sans claude
#   agents <nom>              se (re)connecte à l'agent <nom> (alias : agents attach <nom>)
#   agents title <nom> <titre>  change le titre affiché pour <nom> (sans titre : reprend le nom)
#   agents rm [-f] <nom>      arrête l'agent <nom> sur la VM (ferme sa session screen, donc le claude dedans) et oublie son titre ;
#                             demande confirmation, sauf avec -f
#
# <nom> = identifiant de la session screen (court, sans espace, ex. lot-serie).
# <titre> = ce qui s'affiche dans la fenêtre du terminal et dans la barre en bas de chaque agent (ex. « Lot/Série — ticket 123 »).
# Config locale dans ~/.config/agents/ : host (user@hôte, obligatoire), sync (racine synchronisée, ex. /home/moi/pro),
# dir (dossier par défaut), titles (« nom<TAB>titre »).
# Côté VM, le hook Claude Code envoie une cloche (\a) sur Notification/Stop -> fenêtre « urgente ».
set -euo pipefail

case "${1:-}" in -h|--help|help) sed -n '2,23p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;; esac

CONF="${XDG_CONFIG_HOME:-$HOME/.config}/agents"
TITLES="$CONF/titles"
mkdir -p "$CONF"; touch "$TITLES"

die() { echo "agents: $*" >&2; exit 1; }

# Machine distante (user@hôte) : $AGENTS_HOST, sinon la première ligne de ~/.config/agents/host.
HOST="${AGENTS_HOST:-$(head -n1 "$CONF/host" 2>/dev/null || true)}"
[ -n "$HOST" ] || die "machine distante non configurée : echo user@hôte > $CONF/host (ou export AGENTS_HOST)"
# Dossier de travail par défaut sur la machine distante : $AGENTS_DIR, sinon ~/.config/agents/dir, sinon ~.
DEFAULT_DIR="${AGENTS_DIR:-$(head -n1 "$CONF/dir" 2>/dev/null || true)}"
DEFAULT_DIR="${DEFAULT_DIR:-.}"
# Racine synchronisée (même chemin sur les deux machines, ex. via Mutagen) : $AGENTS_SYNC, sinon ~/.config/agents/sync.
SYNC_ROOT="${AGENTS_SYNC:-$(head -n1 "$CONF/sync" 2>/dev/null || true)}"
SYNC_ROOT="${SYNC_ROOT%/}"

valid_name() { [[ "$1" =~ ^[A-Za-z0-9._-]+$ ]] || die "nom invalide « $1 » (lettres, chiffres, . _ - uniquement)"; }

get_title() { awk -F'\t' -v n="$1" '$1==n {print $2; exit}' "$TITLES"; }
set_title() {
  local tmp; tmp="$(mktemp)"
  awk -F'\t' -v n="$1" '$1!=n' "$TITLES" > "$tmp"
  [ -n "$2" ] && printf '%s\t%s\n' "$1" "$2" >> "$tmp"
  mv "$tmp" "$TITLES"
}

# Sessions de la VM : « nom<TAB>état<TAB>date »
remote_sessions() {
  local out rc=0
  out="$(ssh "$HOST" screen -ls 2>&1)" || rc=$?
  # 255 = échec SSH (clé refusée, agent verrouillé, machine injoignable) : ne pas le confondre avec « aucun agent ».
  [ "$rc" -ne 255 ] || die "connexion SSH à $HOST impossible : ${out##*$'\n'}"
  awk '
    /^\t[0-9]+\./ {
      id=$1; sub(/^[0-9]+\./, "", id)
      state=($0 ~ /Attached/) ? "connecté" : ($0 ~ /Detached/) ? "détaché" : "?"
      date=$2; gsub(/[()]/, "", date)
      printf "%s\t%s\t%s\n", id, state, date
    }' <<< "$out"
}

cmd_ls() {
  local rows; rows="$(remote_sessions)"
  if [ -z "$rows" ]; then echo "Aucun agent sur la VM."; return; fi
  printf '%-22s %-10s %-12s %s\n' AGENT ÉTAT DEPUIS TITRE
  while IFS=$'\t' read -r name state date; do
    printf '%-22s %-10s %-12s %s\n' "$name" "$state" "$date" "$(get_title "$name")"
  done <<< "$rows"
}

# Le lanceur : celui à côté du script (dépôt cloné), sinon celui du paquet.
STARTER="$(dirname "$(readlink -f "$0")")/agent-start"
[ -f "$STARTER" ] || STARTER="/usr/share/omcachy/agent-start"

agent_exists() { remote_sessions | cut -f1 | grep -qx "$1"; }

# (ré)installe le lanceur sur la VM (idempotent) ; le shell de login de la VM est fish, d'où ce script bash.
install_starter() {
  ssh "$HOST" 'mkdir -p ~/.local/bin; cat > ~/.local/bin/agent-start; chmod +x ~/.local/bin/agent-start' < "$STARTER"
}

# Titre de <nom> (ou le nom), en base64 : passé tel quel à la VM, sans souci de guillemets.
title_b64() { local t; t="$(get_title "$1")"; printf %s "${t:-$1}" | base64 -w0; }

connect() {  # connect <nom> : reprend la session existante ; titre de la fenêtre + barre de titre dans screen
  local name="$1" title; valid_name "$name"
  title="$(get_title "$name")"; title="${title:-$name}"
  printf '\033]0;%s\007' "$title"
  install_starter
  exec ssh -t "$HOST" '~/.local/bin/agent-start' --attach "$name" "$(title_b64 "$name")"
}

create() {  # create <nom> <dossier> <avec_claude 0|1> : crée la session, y lance claude en Remote Control
  local name="$1" dir="$2" with_claude="$3" title b64
  title="$(get_title "$name")"; title="${title:-$name}"
  printf '\033]0;%s\007' "$title"
  b64="$(printf %s "$title" | base64 -w0)"
  install_starter
  exec ssh -t "$HOST" '~/.local/bin/agent-start' "$name" "$dir" "$b64" "$with_claude"
}

cmd_new() {
  local dir="" with_claude=1
  while [ $# -gt 0 ]; do
    case "$1" in
      -d) [ $# -ge 2 ] || die "-d demande un dossier"; dir="$2"; shift 2 ;;
      --shell) with_claude=0; shift ;;
      *) break ;;
    esac
  done
  [ $# -ge 1 ] || die "usage : agents new [-d dossier] [--shell] <nom> [titre]"
  if [ -z "$dir" ]; then
    dir="$DEFAULT_DIR"
    # Dossier courant dans la racine synchronisée -> même chemin sur la machine distante.
    if [ -n "$SYNC_ROOT" ] && { [ "$PWD" = "$SYNC_ROOT" ] || [[ "$PWD" == "$SYNC_ROOT"/* ]]; }; then
      if [[ "$PWD" =~ ^[A-Za-z0-9._/~-]+$ ]] && ! ssh "$HOST" test -d "$PWD" 2>/dev/null; then
        echo "agents: $PWD n'existe pas encore sur la machine distante (sync en cours ?) -> dossier par défaut ($DEFAULT_DIR)" >&2
      else
        dir="$PWD"
      fi
    fi
  fi
  local name="$1"; shift; valid_name "$name"
  [ $# -ge 1 ] && set_title "$name" "$*"
  if agent_exists "$name"; then connect "$name"; else create "$name" "$dir" "$with_claude"; fi
}

cmd="${1:-ls}"
case "$cmd" in
  ls|list)   cmd_ls ;;
  _names)    remote_sessions | cut -f1 ;;   # utilisé par l'autocomplétion
  new)       shift; cmd_new "$@" ;;
  attach)    [ $# -ge 2 ] || die "usage : agents attach <nom>"
             remote_sessions | cut -f1 | grep -qx "$2" || die "pas d'agent « $2 » sur la VM (agents ls ; agents new $2)"
             connect "$2" ;;
  title)     [ $# -ge 3 ] || die "usage : agents title <nom> <titre>"
             valid_name "$2"; set_title "$2" "${*:3}"; echo "Titre de $2 : ${*:3}"
             # Met aussi à jour la barre de l'agent s'il tourne déjà (sinon, au prochain attach).
             install_starter && ssh "$HOST" '~/.local/bin/agent-start' --title "$2" "$(title_b64 "$2")" || true ;;
  rm)        shift; force=0; [ "${1:-}" = "-f" ] && { force=1; shift; }
             [ $# -ge 1 ] || die "usage : agents rm [-f] <nom>"
             valid_name "$1"
             if agent_exists "$1"; then
               if [ "$force" != 1 ]; then
                 read -r -p "Arrêter l'agent « $1 » sur la VM (la session et le claude dedans seront fermés) ? [o/N] " rep
                 [[ "$rep" =~ ^[oOyY]$ ]] || die "annulé"
               fi
               ssh "$HOST" "screen -S '$1' -X quit; rm -f ~/.local/share/agents/'$1'.screenrc"
               agent_exists "$1" && die "la session « $1 » tourne encore" || echo "Agent $1 arrêté."
             else
               echo "Pas d'agent « $1 » sur la VM (agents ls)."
             fi
             set_title "$1" "" ;;
  -h|--help|help) sed -n '2,23p' "$0" | sed 's/^# \{0,1\}//' ;;
  *)         # raccourci : agents <nom>
             remote_sessions | cut -f1 | grep -qx "$cmd" || die "pas d'agent « $cmd » (agents ls ; agents new $cmd [titre])"
             connect "$cmd" ;;
esac
