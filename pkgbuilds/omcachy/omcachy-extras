#!/usr/bin/env bash
# Install the applications of an extras list, skipping the ones that fail:
# repository packages with pacman, the others built from the AUR with makepkg.
#
#   omcachy-extras [--yes] [LIST]      as the user: install what is missing
#   omcachy-extras --build DIR [LIST]  as the user: only build the AUR
#                                              packages into DIR (ISO build)
#   omcachy-extras --prebuilt DIR [LIST]
#                                              as root: AUR packages from DIR (ISO install)
#   omcachy-extras private-setup [URL] as the user: optionally add your own private GitHub
#                                              repository (needs gh, logged in): its extras.packages
#                                              is installed too and its scripts/ are linked into
#                                              ~/.local/bin. Not part of the public setup or the ISO.
#
# LIST is a file or an http(s) URL, by default the list on the project's main
# branch, so new entries pushed there are picked up without a package update.
# Once private-setup has been run, a plain run also updates and installs the private list.
set -eEuo pipefail

LIST_URL=https://raw.githubusercontent.com/Siguenos/omcachy/main/extras/extras.packages
AUR_URL=https://aur.archlinux.org

usage() { sed -n '2,18s/^# \{0,1\}//p' "$0"; }

# Print the package names of a list: one per line, '#' starts a comment.
list_packages() { sed 's/#.*//; s/[[:space:]]//g; /^$/d' "$1"; }

# Optional private repository (see private-setup): where it is cloned and where its URL is remembered.
PRIVATE_DIR=${XDG_DATA_HOME:-$HOME/.local/share}/omcachy/private
PRIVATE_CONF=${XDG_CONFIG_HOME:-$HOME/.config}/omcachy/private-repo
PRIVATE_BIN=${XDG_BIN_HOME:-$HOME/.local/bin}
# Create this file to silence the reminder below when you do not use a private repository.
PRIVATE_NO_WARN=${XDG_CONFIG_HOME:-$HOME/.config}/omcachy/no-private

# The project was called omarchy-oncachy before: move what it left in the user's directories.
migrate_legacy_dirs() {
  local base
  for base in "${XDG_CONFIG_HOME:-$HOME/.config}" "${XDG_DATA_HOME:-$HOME/.local/share}" "${XDG_STATE_HOME:-$HOME/.local/state}"; do
    if [[ -d $base/omarchy-oncachy && ! -e $base/omcachy ]]; then mv "$base/omarchy-oncachy" "$base/omcachy"; fi
  done
}

# True when no private repository is set up and the reminder was not silenced.
private_missing() { [[ ! -f $PRIVATE_CONF && ! -f $PRIVATE_NO_WARN ]]; }

# A big, hard to miss reminder at the end of a run (colours only on a terminal).
private_warning() {
  local y='' b='' r=''
  if [[ -t 1 ]]; then y=$'\e[1;33m' b=$'\e[1m' r=$'\e[0m'; fi
  cat <<WARNING_EOF

${y}        /\\
       /  \\       ${b}!!  NO PRIVATE PROFILE ON THIS MACHINE  !!${r}${y}
      / !! \\
     /  !!  \\     Your private scripts and packages are NOT installed here.
    /   !!   \\
   /          \\   Fix it now:
  /     ..     \\
 /______________\\    ${b}omcachy-extras private-setup${r}${y}

                   It asks for the URL of your private repository
                   (needs the GitHub CLI, logged in: gh auth login).
                   Not using one?  touch $PRIVATE_NO_WARN${r}

WARNING_EOF
}

# A GitHub repository URL: https://github.com/OWNER/REPO[.git]
valid_private_url() { [[ $1 =~ ^https://github\.com/[A-Za-z0-9._-]+/[A-Za-z0-9._-]+(\.git)?/?$ ]]; }

# Clone (or update) the private repository and link its scripts/ into PRIVATE_BIN, never over a
# file that is not already one of its links. Does not install packages (see install_private_extras).
sync_private() {
  local url=$1 file target
  if [[ -d $PRIVATE_DIR/.git ]]; then
    # gh is the credential helper: the repository is private and cloned over https.
    git -c credential.helper='!gh auth git-credential' -C "$PRIVATE_DIR" pull --ff-only -q || { echo "Cannot update $PRIVATE_DIR" >&2; return 1; }
  else
    mkdir -p "$(dirname "$PRIVATE_DIR")"
    gh repo clone "$url" "$PRIVATE_DIR" -- -q || { echo "Cannot clone $url" >&2; return 1; }
  fi
  mkdir -p "$PRIVATE_BIN"
  for file in "$PRIVATE_DIR"/scripts/*; do
    [[ -f $file ]] || continue
    target=$PRIVATE_BIN/${file##*/}
    if [[ -L $target && $(readlink -f -- "$target") == "$(readlink -f -- "$file")" ]]; then continue; fi
    # Link made before the rename (the clone moved with it).
    if [[ -L $target && $(readlink -- "$target") == */omarchy-oncachy/private/* ]]; then rm -f -- "$target"; fi
    if [[ -e $target || -L $target ]]; then
      echo "Not linking ${file##*/}: $target already exists" >&2
      continue
    fi
    chmod +x "$file"
    ln -s "$file" "$target"
    echo "Linked $target"
  done
}

private_setup() {
  local url=${1:-}
  command -v gh >/dev/null || { echo "private-setup needs the GitHub CLI (gh)." >&2; return 1; }
  gh auth status >/dev/null 2>&1 || { echo "private-setup needs gh logged in: run 'gh auth login'." >&2; return 1; }
  if [[ -z $url && -f $PRIVATE_CONF ]]; then url=$(head -n1 "$PRIVATE_CONF"); fi
  if [[ -z $url ]]; then
    read -rp "URL of your private GitHub repository (https://github.com/OWNER/REPO): " url
  fi
  valid_private_url "$url" || { echo "Not a GitHub repository URL: $url" >&2; return 1; }
  sync_private "$url" || return 1
  mkdir -p "$(dirname "$PRIVATE_CONF")"
  printf '%s\n' "$url" > "$PRIVATE_CONF"
  echo "Private repository ready ($url)."
  install_private_extras
}

# Install the private list, if there is one: same options as this run.
install_private_extras() {
  [[ -f $PRIVATE_DIR/extras.packages ]] || return 0
  echo "== Private extras"
  "$0" "${self_args[@]}" "$PRIVATE_DIR/extras.packages"
}

as_root() { if (( EUID == 0 )); then "$@"; else sudo "$@"; fi; }

# pacman -S names or -U files in one transaction, or one at a time when it
# fails; adds what could not be installed to the failed array.
pacman_each() {
  local operation=$1 target
  shift
  as_root pacman "$operation" --needed "${confirm[@]}" "$@" && return 0
  for target in "$@"; do
    as_root pacman "$operation" --needed "${confirm[@]}" "$target" || failed+=("${target##*/}")
  done
}

# Build an AUR package into DIR with makepkg (repository dependencies only),
# trying twice: downloads during builds fail now and then.
build_aur() {
  build_aur_once "$@" || build_aur_once "$@"
}

build_aur_once() {
  local name=$1 out=$2 dir=$work/aur/$1 key
  rm -rf "$dir"
  git clone -q --depth 1 "$AUR_URL/$name.git" "$dir" && [[ -f $dir/PKGBUILD ]] || return 1
  # makepkg checks signed sources against the keys the PKGBUILD trusts.
  for key in $(sed -n 's/^[[:space:]]*validpgpkeys = //p' "$dir/.SRCINFO"); do
    gpg --batch --quiet --recv-keys "$key" >/dev/null 2>&1 || true
  done
  (cd "$dir" && PKGDEST=$out makepkg --syncdeps --rmdeps --noconfirm)
}

[[ ${BASH_SOURCE[0]} == "$0" ]] || return 0
migrate_legacy_dirs

mode=install yes=0 dir='' list=$LIST_URL
self_args=()
[[ ${1:-} != private-setup ]] || { shift; (( EUID != 0 )) || { echo "Run as your normal user." >&2; exit 1; }; private_setup "${1:-}"; exit; }
while (( $# )); do
  case $1 in
    --yes) yes=1; self_args+=(--yes) ;;
    --build|--prebuilt)
      [[ -n ${2:-} ]] || { usage >&2; exit 2; }
      mode=${1#--} dir=$(realpath -m -- "$2"); shift ;;
    -h|--help) usage; exit 0 ;;
    -*) usage >&2; exit 2 ;;
    *) list=$1 ;;
  esac
  shift
done
if [[ $mode == prebuilt ]]; then
  (( EUID == 0 )) || { echo "--prebuilt must run as root." >&2; exit 1; }
  yes=1
else
  (( EUID != 0 )) || { echo "Run as your normal user (makepkg does not build as root)." >&2; exit 1; }
fi

work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT
if [[ $list == http://* || $list == https://* ]]; then
  curl -fsSL -o "$work/list" "$list" || { echo "Cannot download $list" >&2; exit 1; }
else
  cp -- "$list" "$work/list"
fi
mapfile -t packages < <(list_packages "$work/list")
available=$(pacman -Slq)
repo=() aur=() failed=() confirm=()
for package in "${packages[@]}"; do
  if grep -qxF "$package" <<< "$available"; then repo+=("$package"); else aur+=("$package"); fi
done
(( !yes )) || confirm=(--noconfirm)

case $mode in
  build)
    mkdir -p "$dir"
    for package in "${aur[@]}"; do
      echo "== Building $package"
      build_aur "$package" "$dir" || failed+=("$package")
    done
    ;;
  install)
    (( ! ${#repo[@]} )) || pacman_each -S "${repo[@]}"
    for package in "${aur[@]}"; do
      if pacman -Q "$package" >/dev/null 2>&1; then continue; fi
      echo "== Building $package"
      rm -rf "$work/out"
      if build_aur "$package" "$work/out"; then
        pacman_each -U "$work/out"/*.pkg.tar.*
      else
        failed+=("$package")
      fi
    done
    ;;
  prebuilt)
    (( ! ${#repo[@]} )) || pacman_each -S "${repo[@]}"
    files=()
    for package in "${aur[@]}"; do
      file=''
      for candidate in "$dir/$package"-*.pkg.tar.*; do
        if [[ -f $candidate && $(pacman -Qqp "$candidate") == "$package" ]]; then file=$candidate; fi
      done
      if [[ -n $file ]]; then files+=("$file"); else failed+=("$package (not built)"); fi
    done
    (( ! ${#files[@]} )) || pacman_each -U "${files[@]}"
    ;;
esac

if (( ${#failed[@]} )); then
  echo "Skipped, could not be installed or built: ${failed[*]}"
else
  echo "Extras done."
fi

# A plain run (default public list) also refreshes the private repository, if one was set up.
if [[ $mode == install && $list == "$LIST_URL" && -f $PRIVATE_CONF ]] && command -v gh >/dev/null; then
  if sync_private "$(head -n1 "$PRIVATE_CONF")"; then install_private_extras; fi
fi

# ... and reminds you when there is none, so that forgetting it does not go unnoticed.
if [[ $mode == install && $list == "$LIST_URL" ]] && private_missing; then private_warning; fi
